rules_version = '2';

// Farmer documents (7/12 extract, soil health card, insurance papers, ...)
// are stored at users/{userId}/documents/... and are private to that user.
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/documents/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // PDF / JPG / PNG only, max 10 MB.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
