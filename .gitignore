# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Native build output
/android/build/
**/Pods/

# Firebase config — contains project keys; kept local only.
# Copy the *.example files and fill them in (see README).
# (Patterns match in any folder, so a misplaced copy can't be committed.)
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options.dart

# Firebase CLI local cache (firebase.json, .firebaserc and the rules files
# ARE committed; this folder is only a deploy cache).
.firebase/

# Local secrets
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
# Build-time defines, e.g. `flutter run --dart-define-from-file=dart_defines.json`
dart_defines*.json
!dart_defines.example.json

# Local databases / dumps from running the app on a desktop or emulator
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Test output: golden-image comparison failures are regenerated on every run
test/**/failures/
